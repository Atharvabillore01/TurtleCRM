# =============================================================================
# Turtle Corporate — deployment .env (minimal, actively-used vars only)
#
# Copy to `.env` (compose reads `.env` via `env_file:` on every service) and
# fill in the FILL_ME values. Everything in this file is referenced by either
# docker-compose.yml or a service's config.py. Vars from .env.example that
# aren't referenced in code have been omitted on purpose.
# =============================================================================

NODE_ENV=production

# ── Postgres (managed instance the services connect to) ─────────────────────
# DATABASE_URL is consumed by auth-service + meeting-service via pydantic
# settings. The POSTGRES_* trio is consumed by the local `postgres` container
# in docker-compose (only relevant if you keep that container; for a managed
# DB, set DATABASE_URL and you can drop the postgres service from compose).
DATABASE_URL=postgresql://FILL_ME:FILL_ME@FILL_ME:5432/FILL_ME
POSTGRES_USER=FILL_ME
POSTGRES_PASSWORD=FILL_ME
POSTGRES_DB=FILL_ME

# ── Redis ───────────────────────────────────────────────────────────────────
# REDIS_URL is built per-container in compose as redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=FILL_ME

# ── RabbitMQ ────────────────────────────────────────────────────────────────
# RABBITMQ_URL is built per-container in compose as amqp://turtle:${RABBITMQ_PASS}@rabbitmq:5672
RABBITMQ_USER=turtle
RABBITMQ_PASS=FILL_ME

# ── JWT (auth-service issues, meeting-service verifies — must match) ────────
JWT_SECRET=FILL_ME_min_32_chars
REFRESH_TOKEN_SECRET=FILL_ME_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── App origins (CORS allowlist on auth-service + meeting-service) ──────────
CLIENT_APP_URL=https://client.your-domain.tld
ADVISOR_APP_URL=https://advisor.your-domain.tld
INTERNAL_APP_URL=https://internal.your-domain.tld

# ── Google OAuth (used by auth-service for advisor + internal login) ────────
GOOGLE_CLIENT_ID=FILL_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=FILL_ME
GOOGLE_CALLBACK_URL=https://auth.your-domain.tld/auth/oauth/google/callback
GOOGLE_INTERNAL_CALLBACK_URL=https://auth.your-domain.tld/auth/oauth/internal/google/callback

# ── Google Calendar (meeting-service creates Meet events via DWD) ───────────
# GOOGLE_SERVICE_ACCOUNT_FILE is the in-container path; mount the key via the
# meeting-service `volumes:` block in compose.
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/gcp-sa.json
GOOGLE_IMPERSONATE_EMAIL=FILL_ME@your-workspace.tld
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# ── Fireflies webhook (meeting-service receives transcripts) ────────────────
FIREFLY_API_KEY=FILL_ME
FIREFLY_WEBHOOK_SECRET=FILL_ME
FIREFLY_BOT_EMAIL=FILL_ME@your-domain.tld

# ── CRM AI agent (transcript_processor + summary_worker target) ─────────────
CRM_AI_SERVICE_URL=http://13.207.65.145

# ── OTP (mock keeps the otp-service quiet; switch + add creds if/when the
#       client-app/advisor-app OTP flow is rolled out) ────────────────────────
OTP_PROVIDER=mock

# ── Event bus (rabbitmq is the only one wired in compose) ───────────────────
EVENT_BUS=rabbitmq

# ── Frontend (Vite reads VITE_* at build time; bake into the static images) ─
VITE_AUTH_SERVICE_URL=https://auth.your-domain.tld
VITE_USER_SERVICE_URL=https://user.your-domain.tld
VITE_MEETING_SERVICE_URL=https://meeting.your-domain.tld
VITE_SHOW_DEV_TOGGLE=false
