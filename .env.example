# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=turtle
POSTGRES_PASSWORD=changeme
POSTGRES_DB=turtle_corporate
DATABASE_URL=postgresql://turtle:changeme@localhost:5432/turtle_corporate

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6379

# ─── Event Bus ───────────────────────────────────────────────────────────────
# Options: kafka | rabbitmq | aws-sns | redis-streams | eventbridge
EVENT_BUS=redis-streams
KAFKA_BROKERS=kafka:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# AWS SNS + SQS (EVENT_BUS=aws-sns)
# Optional — set per topic, or let the adapter derive from AWS_ACCOUNT_ID + topic slug
AWS_ACCOUNT_ID=
AWS_SNS_ARN_AUTH_OTP_REQUESTED=
AWS_SNS_ARN_AUTH_OTP_VERIFIED=
AWS_SNS_ARN_AUTH_LOGIN_SUCCESS=
AWS_SNS_ARN_AUTH_LOGIN_FAILED=
AWS_SNS_ARN_AUTH_TOKEN_REFRESHED=
# One SQS queue URL per service (the queue this service polls)
AWS_SQS_QUEUE_URL=

# AWS EventBridge (EVENT_BUS=eventbridge)
AWS_EVENTBRIDGE_BUS_NAME=turtle-corporate
# SQS queue that EventBridge rule delivers to (one per service)
# aws-sns and eventbridge share AWS_SQS_QUEUE_URL above

# Per-service SQS queue URLs (set in each service's environment)
AWS_SQS_OTP_QUEUE_URL=
AWS_SQS_USER_QUEUE_URL=
AWS_SQS_NOTIFICATION_QUEUE_URL=

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=changeme_jwt_secret_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=changeme_refresh_secret_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── OTP Provider ────────────────────────────────────────────────────────────
# Options: twilio | infobip | aws | msg91 | haptic | mock
OTP_PROVIDER=twilio
OTP_EXPIRES_IN_SECONDS=300
OTP_LENGTH=6
OTP_RATE_LIMIT_MAX_REQUESTS=3
OTP_RATE_LIMIT_WINDOW_SECS=900

# Twilio (OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AWS SNS (OTP_PROVIDER=aws)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_SNS_SENDER_ID=

# MSG91 (OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
MSG91_EMAIL_DOMAIN=

# Haptic (OTP_PROVIDER=haptic)
HAPTIC_API_KEY=
HAPTIC_SENDER_ID=
HAPTIC_BASE_URL=

# Infobip (OTP_PROVIDER=infobip)
INFOBIP_API_KEY=
INFOBIP_SENDER_ID=
INFOBIP_BASE_URL=https://api.infobip.com

# ─── Email / Notifications ───────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@turtlecorporate.com
SENDGRID_FROM_NAME=Turtle Corporate

# ─── OAuth (internal-app) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/oauth/google/callback
GOOGLE_INTERNAL_CALLBACK_URL=http://localhost:4000/auth/oauth/internal/google/callback

# ─── Service Ports ───────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=4000
OTP_SERVICE_PORT=4001
USER_SERVICE_PORT=4002
NOTIFICATION_SERVICE_PORT=4003

# ─── App URLs (used by services for internal calls) ──────────────────────────
AUTH_SERVICE_URL=http://auth-service:4000
OTP_SERVICE_URL=http://otp-service:4001
USER_SERVICE_URL=http://user-service:4002
NOTIFICATION_SERVICE_URL=http://notification-service:4003

# ─── Frontend ────────────────────────────────────────────────────────────────
CLIENT_APP_URL=http://localhost:3000
ADVISOR_APP_URL=http://localhost:3001
INTERNAL_APP_URL=http://localhost:3002

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development
